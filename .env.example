# Ortam degiskenleri ornegi.
# `cp .env.example .env` ile kopyalayin. .env ASLA depoya eklenmez.

# --- Veritabani ---------------------------------------------------------
DATABASE_URL=postgres://medentry:medentry@127.0.0.1:5432/medentry

# --- Sunucu -------------------------------------------------------------
HOST=0.0.0.0
PORT=8080
NODE_ENV=development
# Uretimde arayuz kokeniyle sinirlayin: https://filo.ornek-firma.com.tr
CORS_ORIGINS=*

# --- Guvenlik -----------------------------------------------------------
# Uretimde ZORUNLU. Uretmek icin: openssl rand -base64 48
JWT_SECRET=gelistirme-ortami-icin-gecici-anahtar-degistirin
JWT_TTL_SECONDS=43200

# Cihaz girisi paylasilan anahtari. Uretimde ZORUNLU ve ingest ile ayni olmali.
INGEST_KEY=gelistirme-ingest-anahtari

# --- Medya (kamera) -----------------------------------------------------
# mock: donanimsiz demo | jt1078: gercek 4G MDVR
MEDIA_PROVIDER=mock
# Cihazin RTP akisini acacagi, disaridan erisilebilir adres
MEDIA_GATEWAY_HOST=127.0.0.1
MEDIA_GATEWAY_TCP_PORT=7618
MEDIA_GATEWAY_UDP_PORT=0
# Izleyiciye verilen HLS taban adresi
MEDIA_PLAYBACK_BASE_URL=http://127.0.0.1:8888
# Yayin jetonu omru (saniye) - kisa tutun
MEDIA_TOKEN_TTL_SECONDS=120
# Canli izleme ust siniri (saniye)
MEDIA_LIVE_MAX_SECONDS=300
# Ingest komut kanali
MEDIA_COMMAND_ENDPOINT=http://127.0.0.1:8081/command
# Olay klibi yukleme hedefi (cihaz FTP ile yukler)
MEDIA_FTP_HOST=127.0.0.1
MEDIA_FTP_PORT=21
MEDIA_FTP_USER=mdvr
MEDIA_FTP_PASSWORD=degistirin

# --- Oturum motoru ------------------------------------------------------
# Kontagin bu sureden kisa kapali kalmasi oturumu bolmez
SESSION_MERGE_GAP_SEC=180
# Bu surenin altindaki oturumlar gurultu sayilir
SESSION_MIN_SEC=60
# Veri kesintisi bu sureyi asarsa oturum son kayitta kapatilir
SESSION_MAX_GAP_SEC=1800
# Bu surenin altindaki duraklamalar rolanti sayilmaz
SESSION_IDLE_MIN_SEC=300

# --- Periyodik isler ----------------------------------------------------
JOB_ROLLUP_INTERVAL_MS=900000
JOB_STALE_SESSION_INTERVAL_MS=300000
JOB_RETENTION_ENABLED=true
JOB_RETENTION_INTERVAL_MS=21600000

# --- Ingest sunucusu ----------------------------------------------------
API_URL=http://127.0.0.1:8080
COMMAND_PORT=8081
PORT_GT06=5023
PORT_TELTONIKA=5027
PORT_JT808=7611

# --- Testler ------------------------------------------------------------
TEST_DATABASE_URL=postgres://medentry:medentry@127.0.0.1:5432/medentry_test

# --- Demo verisi --------------------------------------------------------
SEED_PASSWORD=Medentry2026!
