# ---------------------------------------------------------------------------
# MİRFİX Operasyon Katmanı — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
# ---------------------------------------------------------------------------

# Uygulama
PORT=8080
NODE_ENV=development
TZ=Europe/Istanbul
# Oturum çerezlerini imzalar. Üretimde MUTLAKA değiştirin: openssl rand -hex 32
OTURUM_SIRRI=degistirin-bu-degeri-uretimde-mutlaka

# Operasyon veritabanı (bizim PostgreSQL'imiz)
DATABASE_URL=postgres://mirfix:mirfix@localhost:5432/mirfix

# Mikro veri kaynağı: seed | csv | mssql
#   seed  → gerçekçi sahte veri (Mikro'suz geliştirme ve demo)
#   csv   → Mikro'dan alınan export dosyaları (MIKRO_CSV_DIZIN)
#   mssql → Mikro MSSQL veritabanı, salt-okunur kullanıcı
MIKRO_ADAPTER=seed

# csv adapter için
MIKRO_CSV_DIZIN=./veri/mikro-export

# mssql adapter için (salt-okunur kullanıcı; sorgular docs/mikro-eslesme.json'da)
MIKRO_MSSQL_SUNUCU=192.168.1.10
MIKRO_MSSQL_PORT=1433
MIKRO_MSSQL_VERITABANI=MikroDB_V16
MIKRO_MSSQL_KULLANICI=mirfix_okuma
MIKRO_MSSQL_PAROLA=
MIKRO_MSSQL_SIFRELI=false

# Zamanlanmış işler (kapatmak için 0 yapın — testte/geliştirmede kapalı tutulabilir)
ISLER_ACIK=1

# Yedekleme (W-15)
YEDEK_DIZIN=./yedek
YEDEK_SAKLAMA_GUN=14
